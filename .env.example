# Jigsaw Policy Assistant - copy to .env and fill in the values marked CHANGE_ME. Never commit .env.
# Generate passwords with:  python -c "import secrets; print(secrets.token_urlsafe(24))"
# Use only letters, digits, - and _ in database passwords (they are placed inside connection URLs).

# --- Database (docker compose) ---------------------------------------------------------------------
POSTGRES_DB=jigsaw_policy
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
APP_DB_USER=jigsaw_app
APP_DB_PASSWORD=CHANGE_ME
# Host ports, bound to 127.0.0.1 only
DB_PORT=5432
APP_PORT=8000

# --- Application -----------------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
# Set to your https:// address when running behind a TLS proxy (enables Secure cookies).
PUBLIC_BASE_URL=http://localhost:8000

# --- OpenAI ----------------------------------------------------------------------------------------
OPENAI_API_KEY=CHANGE_ME
OPENAI_CHAT_MODEL=gpt-6-luna
# none | low | medium | high (gpt-6 models are reasoning models; the API default is medium)
OPENAI_REASONING_EFFORT=low
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- Answering -------------------------------------------------------------------------------------
# LLM check of every statement against its cited text (deterministic checks always run).
GROUNDING_JUDGE=true
RETRIEVAL_TOP_K=6
# Cross-encoder reranking of the search results (local model, baked into the Docker image).
# Changing RERANKER_MODEL needs: docker compose build --build-arg RERANKER_MODEL=<same model>
RERANKER_ENABLED=true
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RERANKER_CANDIDATES=20

# --- Seed data -------------------------------------------------------------------------------------
# Password for the sample staff accounts created by `python -m app.cli seed`. Leave empty to have a
# random password generated and printed once.
SEED_PASSWORD=
